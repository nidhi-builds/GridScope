  "components": {
    "schemas": {
      "AssignTicket": {
        "properties": {
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "operator"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          },
          "evidence_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Evidence Ids"
          },
          "crew_label": {
            "type": "string",
            "minLength": 1,
            "title": "Crew Label"
          }
        },
        "type": "object",
        "required": [
          "crew_label"
        ],
        "title": "AssignTicket"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "additionalProperties": true,
            "type": "object",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Page": {
        "properties": {
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Items"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "title": "Page"
      },
      "ReadyResponse": {
        "properties": {
          "database": {
            "type": "string",
            "title": "Database"
          },
          "seed": {
            "type": "string",
            "title": "Seed"
          },
          "worker": {
            "type": "string",
            "title": "Worker"
          },
          "last_processed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Processed At"
          },
          "unprocessed_count": {
            "type": "integer",
            "title": "Unprocessed Count"
          },
          "oldest_backlog_age_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oldest Backlog Age Seconds"
          }
        },
        "type": "object",
        "required": [
          "database",
          "seed",
          "worker",
          "last_processed_at",
          "unprocessed_count",
          "oldest_backlog_age_seconds"
        ],
        "title": "ReadyResponse"
      },
      "TelemetryPayload": {
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid",
            "title": "Device Id"
          },
          "pole_id": {
            "type": "string",
            "format": "uuid",
            "title": "Pole Id"
          },
          "seq": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Seq"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "heartbeat",
              "boot",
              "power_lost",
              "power_restored"
            ],
            "title": "Event Type"
          },
          "energized": {
            "type": "boolean",
            "title": "Energized"
          },
          "firmware": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Firmware"
          },
          "battery": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Battery"
          },
          "rssi": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rssi"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "pole_id",
          "seq",
          "ts",
          "event_type",
          "energized"
        ],
        "title": "TelemetryPayload"
      },
      "TicketAction": {
        "properties": {
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "operator"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          },
          "evidence_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "type": "object",
        "title": "TicketAction"
      },
      "TicketActionResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "incident": {
            "additionalProperties": true,
            "type": "object",
            "title": "Incident"
          },
          "ticket_event": {
            "additionalProperties": true,
            "type": "object",
            "title": "Ticket Event"
          }
        },
        "type": "object",
        "required": [
          "code",
          "incident",
          "ticket_event"
        ],
        "title": "TicketActionResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
