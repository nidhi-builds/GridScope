# Copy to .env only if you need to override a default. `docker compose up` needs none of these.
DATABASE_URL=postgresql+psycopg://gridscope:gridscope@db:5432/gridscope
APP_ENV=development
LOG_LEVEL=INFO
SEED=true
# Record every online device as last reporting energised at seed time, so the map
# opens green instead of grey. Leave false when running the backend test suites.
SEED_BASELINE_LIVE=false
# Routine heartbeats from online devices, in seconds. 0 disables. Without this a
# live pole decays to "not reporting" after 15 minutes, because nothing else in
# the system generates the traffic a real device would send.
HEARTBEAT_SWEEP_SECONDS=0

# Optional. Without a key the deterministic fallback explanation is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Inbox worker
WORKER_BATCH_SIZE=100
POLL_INTERVAL_MS=3000

# Ingest concurrency. Keep (pool + overflow) x processes under PostgreSQL max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REQUEST_THREAD_LIMIT=80
